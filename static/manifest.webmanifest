{
  "name": "Duracash",
  "short_name": "Duracash",
  "description": "Get finished work billed and collected.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f3ee",
  "theme_color": "#8c3f1d",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            ".heic",
            ".eml",
            ".csv",
            ".xlsx",
            ".xls",
            ".docx",
            ".doc",
            ".txt",
            "text/plain"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Take a photo",
      "short_name": "Photo",
      "description": "Open the Inbox with the camera button ready.",
      "url": "/communications?camera=1",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Daily record",
      "short_name": "Daily",
      "description": "Write today's note for a job.",
      "url": "/jobs/daily",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New job",
      "short_name": "New job",
      "description": "Start a new job.",
      "url": "/jobs?new=1",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
